# Copy this file to .env (same folder) and fill in only the brokers you use.
# .env is git-ignored: never commit or share it.

# Zerodha Kite Connect: https://developers.kite.trade  (create an app, redirect URL below)
#   Redirect URL: http://127.0.0.1:8766/callback/zerodha
KITE_API_KEY=
KITE_API_SECRET=

# Upstox: https://account.upstox.com/developer/apps  (create an app, redirect URL below)
#   Redirect URL: http://127.0.0.1:8766/callback/upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Angel One SmartAPI: https://smartapi.angelone.in  (create a "Publisher" app, redirect URL below)
#   Redirect URL: http://127.0.0.1:8766/callback/angel
ANGEL_API_KEY=

# Optional: extra dashboard addresses allowed to read holdings, comma separated
BULLSCOPE_EXTRA_ORIGINS=
