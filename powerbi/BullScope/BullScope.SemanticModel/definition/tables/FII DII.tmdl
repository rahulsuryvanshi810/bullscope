	column 'nifty_close'
		dataType: double
		formatString: #,0.00
		lineageTag: 118a9d29-2f92-4996-99f1-95d014822f53
		summarizeBy: none
		sourceColumn: nifty_close

	partition 'FII DII' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "fact_fii_dii.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Keep    = Table.SelectColumns(Headers, {"date", "fii_buy", "fii_sell", "fii_net", "dii_buy", "dii_sell", "dii_net", "nifty_close"}),
				    Blanks  = Table.ReplaceValue(Keep, "", null, Replacer.ReplaceValue, {"date", "fii_buy", "fii_sell", "fii_net", "dii_buy", "dii_sell", "dii_net", "nifty_close"}),
				    Typed   = Table.TransformColumnTypes(Blanks, {
				        {"date", type date},
				        {"fii_buy", type number},
				        {"fii_sell", type number},
				        {"fii_net", type number},
				        {"dii_buy", type number},
				        {"dii_sell", type number},
				        {"dii_net", type number},
				        {"nifty_close", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

