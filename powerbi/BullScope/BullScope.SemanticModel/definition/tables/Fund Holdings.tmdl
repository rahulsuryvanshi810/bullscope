	partition 'Fund Holdings' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "fact_fund_holdings.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Keep    = Table.SelectColumns(Headers, {"scheme_code", "symbol", "company", "sector", "cap_bucket", "weight_pct", "value_cr", "prev_value_cr", "change_cr", "change", "stake_pct"}),
				    Blanks  = Table.ReplaceValue(Keep, "", null, Replacer.ReplaceValue, {"scheme_code", "weight_pct", "value_cr", "prev_value_cr", "change_cr", "stake_pct"}),
				    Typed   = Table.TransformColumnTypes(Blanks, {
				        {"scheme_code", Int64.Type},
				        {"symbol", type text},
				        {"company", type text},
				        {"sector", type text},
				        {"cap_bucket", type text},
				        {"weight_pct", type number},
				        {"value_cr", type number},
				        {"prev_value_cr", type number},
				        {"change_cr", type number},
				        {"change", type text},
				        {"stake_pct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

