	partition 'Option Chain' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "fact_option_chain.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Keep    = Table.SelectColumns(Headers, {"underlying", "expiry", "strike", "type", "ltp", "iv", "oi", "chg_oi", "volume", "delta", "gamma", "theta", "vega", "spot", "lot_size"}),
				    Blanks  = Table.ReplaceValue(Keep, "", null, Replacer.ReplaceValue, {"expiry", "strike", "ltp", "iv", "oi", "chg_oi", "volume", "delta", "gamma", "theta", "vega", "spot", "lot_size"}),
				    Typed   = Table.TransformColumnTypes(Blanks, {
				        {"underlying", type text},
				        {"expiry", type date},
				        {"strike", type number},
				        {"type", type text},
				        {"ltp", type number},
				        {"iv", type number},
				        {"oi", type number},
				        {"chg_oi", type number},
				        {"volume", type number},
				        {"delta", type number},
				        {"gamma", type number},
				        {"theta", type number},
				        {"vega", type number},
				        {"spot", type number},
				        {"lot_size", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

