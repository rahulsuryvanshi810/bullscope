		lineageTag: 30a900ad-939b-462d-a645-f129629c2ae3
		formatString: 0.00
		displayFolder: 5 Mutual Funds

	measure 'Avg Max Drawdown %' = AVERAGE ( Funds[max_drawdown] )
		lineageTag: 6fa17735-b572-43d0-8b5c-ea6a41357e8c
		formatString: 0.0%
		displayFolder: 5 Mutual Funds

	measure 'Avg Fund Score' = AVERAGE ( Funds[score] )
		lineageTag: ce777f00-ecf2-4e76-8519-7ff4006ed6e3
		formatString: 0.0
		displayFolder: 5 Mutual Funds

	measure 'SIP XIRR %' = AVERAGE ( Funds[sip_xirr] )
		lineageTag: f0b5156b-b82c-4074-afd5-dea589d7fd6c
		formatString: 0.0%
		displayFolder: 5 Mutual Funds

	measure 'Top Fund by Score' = MAXX ( TOPN ( 1, Funds, Funds[score], DESC ), Funds[fund] )
		lineageTag: 3270e4fa-abae-4f43-bcae-8081bdf070aa
		displayFolder: 5 Mutual Funds

	measure 'Holding Value (Cr)' = SUM ( 'Fund Holdings'[value_cr] )
		lineageTag: f2e9702d-11e9-4daa-ae69-81a35d3d9e56
		formatString: ₹#,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Holding Change (Cr)' = SUM ( 'Fund Holdings'[change_cr] )
		lineageTag: 9f871ce7-5487-4d4f-abb7-a385aa0b7b14
		formatString: ₹#,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Bought by Funds (Cr)' = CALCULATE ( [Holding Change (Cr)], 'Fund Holdings'[change_cr] > 0 )
		lineageTag: 1fe771d6-d917-4793-a9d3-c2e6505cc686
		formatString: ₹#,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Sold by Funds (Cr)' = CALCULATE ( [Holding Change (Cr)], 'Fund Holdings'[change_cr] < 0 )
		lineageTag: 81d2c7de-4ce1-4b90-a669-7833b841d0a0
		formatString: ₹#,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Total Fund Stake %' = DIVIDE ( SUM ( 'Fund Holdings'[stake_pct] ), 100 )
		lineageTag: 5380b904-688c-4015-aab9-7e494f2d4796
		formatString: 0.0%
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Funds Holding' = CALCULATE ( DISTINCTCOUNT ( 'Fund Holdings'[scheme_code] ), 'Fund Holdings'[value_cr] > 0 )
		lineageTag: 8dedf9fb-4bb0-4f20-b27c-40266703b636
		formatString: #,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Portfolio Weight %' = DIVIDE ( SUM ( 'Fund Holdings'[weight_pct] ), 100 )
		lineageTag: aa38d0a1-6ba2-4efe-b11c-6eb62095eef6
		formatString: 0.0%
		displayFolder: 6 Fund Holdings (modelled)

	measure 'New Positions' = CALCULATE ( COUNTROWS ( 'Fund Holdings' ), 'Fund Holdings'[change] = "New" )
		lineageTag: bf85bf0e-ad64-456c-a10f-aa3ff0bbac67
		formatString: #,0
		displayFolder: 6 Fund Holdings (modelled)

	measure 'Exited Positions' = CALCULATE ( COUNTROWS ( 'Fund Holdings' ), 'Fund Holdings'[change] = "Exit" )
		lineageTag: 91b0e1d9-9d92-42af-ac8d-0e44e71e43a6
		formatString: #,0
