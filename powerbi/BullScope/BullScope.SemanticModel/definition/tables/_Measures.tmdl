	measure 'FII Net (Cr)' = SUM ( 'FII DII'[fii_net] )
		lineageTag: eb1fa9f2-d10b-41d0-b317-347038f16a81
		formatString: ₹#,0
		displayFolder: 4 FII DII (modelled)

	measure 'DII Net (Cr)' = SUM ( 'FII DII'[dii_net] )
		lineageTag: d20eac17-4e20-4d1a-9983-36e375d66ed4
		formatString: ₹#,0
		displayFolder: 4 FII DII (modelled)

	measure 'FII Buy Days %' = DIVIDE ( CALCULATE ( COUNTROWS ( 'FII DII' ), 'FII DII'[fii_net] > 0 ), COUNTROWS ( 'FII DII' ) )
		lineageTag: 39118497-3a43-42ba-9f0f-06cbcb9bc326
		formatString: 0.0%
