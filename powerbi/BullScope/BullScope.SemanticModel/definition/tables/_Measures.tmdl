table _Measures
	lineageTag: 5958a499-eeea-463e-a1e8-ac6843e42caf

	measure 'Last Close' = 
			CALCULATE (
			    SUM ( 'Stock Prices'[close] ),
			    LASTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Stock Prices' ) ) )
			)
		lineageTag: 3e896c64-e117-4ac3-919c-4ea3e1805081
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'First Close' = 
			CALCULATE (
			    SUM ( 'Stock Prices'[close] ),
			    FIRSTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Stock Prices' ) ) )
			)
		lineageTag: 702cdd20-2862-48b8-88f4-ef125e9953d2
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'Period Return %' = DIVIDE ( [Last Close], [First Close] ) - 1
		lineageTag: 4d71c366-b41b-4143-8b10-550cd5704f32
		formatString: 0.0%
		displayFolder: 1 Stocks

	measure 'Avg Stock Return %' = AVERAGEX ( VALUES ( Stocks[sym] ), [Period Return %] )
		lineageTag: ce9e1a11-fcbb-4e59-bbdd-cf7c9c96e9ec
		formatString: 0.0%
		displayFolder: 1 Stocks

	measure 'Period High' = MAX ( 'Stock Prices'[high] )
		lineageTag: aaf91531-0200-41f0-8768-a84fa76afde6
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'Period Low' = MIN ( 'Stock Prices'[low] )
		lineageTag: ee87905e-4ca4-45ea-8dfa-6a56d12dbc9a
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'Volatility %' = STDEV.S ( 'Stock Prices'[daily_return] ) * SQRT ( 252 )
		lineageTag: e0ccedc5-f05d-476e-9a84-a51aa9d3d7c7
		formatString: 0.0%
		displayFolder: 1 Stocks

	measure 'Total Volume' = SUM ( 'Stock Prices'[volume] )
		lineageTag: e3c43657-1d8c-4bac-83b4-09ef2260e70f
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Sessions' = DISTINCTCOUNT ( 'Stock Prices'[date] )
		lineageTag: 27cb6f2a-8da0-4097-be0f-051b1b66b5a9
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Advancers' = COUNTROWS ( FILTER ( VALUES ( Stocks[sym] ), [Period Return %] > 0 ) )
		lineageTag: 35ebd32d-9ad6-40ab-8821-2ddb45b89cd9
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Decliners' = COUNTROWS ( FILTER ( VALUES ( Stocks[sym] ), [Period Return %] < 0 ) )
		lineageTag: afffcfd2-341e-440b-97c7-00aab7b56ea7
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Market Cap (Cr)' = SUM ( Stocks[mcap_cr] )
		lineageTag: 81627cf1-4394-42e6-9a58-7e8aa25d6b29
		formatString: ₹#,0
		displayFolder: 1 Stocks

	measure 'BSE Close' = SELECTEDVALUE ( Stocks[bse_close] )
		lineageTag: e87d1c78-e7c4-41c7-8049-7b717d106c60
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'NSE BSE Spread' = IF ( HASONEVALUE ( Stocks[sym] ), CALCULATE ( [Last Close], ALL ( 'Date' ) ) - [BSE Close] )
		lineageTag: a2607723-17a0-4f49-8d01-280fd89a40c0
		formatString: #,0.00
		displayFolder: 1 Stocks

	measure 'Signal Score' = SELECTEDVALUE ( Stocks[score] )
		lineageTag: 0b49452d-46d4-43f3-9450-281c6c6f7633
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'ML Chance Up 20d %' = AVERAGE ( Stocks[p_up_20d] )
		lineageTag: 217d65a0-c568-41cd-9563-f61600e85ece
		formatString: 0.0%
		displayFolder: 1 Stocks

	measure 'Buy Signals' = CALCULATE ( COUNTROWS ( Stocks ), Stocks[score] > 0 )
		lineageTag: 295d6fbf-430f-401d-bad4-09e2a319dcb4
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Sell Signals' = CALCULATE ( COUNTROWS ( Stocks ), Stocks[score] < 0 )
		lineageTag: b4a69f3c-8d3a-4d99-b11c-21c9bdc14f1f
		formatString: #,0
		displayFolder: 1 Stocks

	measure 'Turnover (Cr)' = SUM ( 'Stock Prices'[turnover_cr] )
		lineageTag: 1ca3c448-0279-46a6-8f97-97b06d7ce3c9
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Avg Daily Turnover (Cr)' = DIVIDE ( [Turnover (Cr)], [Sessions] )
		lineageTag: b0e6a969-e213-42b0-b1ee-dba313432e61
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Buy Value (Cr)' = SUM ( 'Stock Prices'[buy_value_cr] )
		lineageTag: 093923de-8bab-4e3b-a628-6bfbe767dcea
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Sell Value (Cr)' = SUM ( 'Stock Prices'[sell_value_cr] )
		lineageTag: 8d7248e2-951f-48d0-9e84-f058d5a804eb
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Sell Value Negative (Cr)' = - [Sell Value (Cr)]
		lineageTag: 0ab54bde-20a0-4502-ae06-809725e97977
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Net Flow (Cr)' = [Buy Value (Cr)] - [Sell Value (Cr)]
		lineageTag: eededb07-e623-4689-9d59-cd2a4eea04e7
		formatString: ₹#,0
		displayFolder: 2 Buy Sell Flow

	measure 'Net Flow %' = DIVIDE ( [Net Flow (Cr)], [Turnover (Cr)] )
		lineageTag: 0a368ce7-dc57-4131-b8e1-daa7cbceabde
		formatString: 0.0%
		displayFolder: 2 Buy Sell Flow

	measure 'Net Flow Rank' = RANKX ( ALLSELECTED ( Stocks[sym] ), [Net Flow (Cr)], , DESC, DENSE )
		lineageTag: ae9bec36-35c7-436c-9b99-62c6e61fecc0
		formatString: #,0.00
		displayFolder: 2 Buy Sell Flow

	measure 'Show Top N Bought' = IF ( [Net Flow Rank] <= SELECTEDVALUE ( 'Top N'[Top N], 10 ), 1, 0 )
		lineageTag: 5a8aaeca-1a50-4ec3-aabc-25fa3fe12e47
		formatString: #,0
		displayFolder: 2 Buy Sell Flow

	measure 'Show Top N Sold' = 
			VAR _r = RANKX ( ALLSELECTED ( Stocks[sym] ), [Net Flow (Cr)], , ASC, DENSE )
			RETURN IF ( _r <= SELECTEDVALUE ( 'Top N'[Top N], 10 ), 1, 0 )
		lineageTag: dfed2c43-e256-46dc-8f54-86b7c7b5b2bc
		formatString: #,0
		displayFolder: 2 Buy Sell Flow

