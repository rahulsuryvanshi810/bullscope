	measure 'NAV' = AVERAGE ( 'Fund NAV'[nav] )
		lineageTag: 59e4b671-4774-4c58-85f8-bc16f7860b50
		formatString: #,0.00
		displayFolder: 5 Mutual Funds

	measure 'NAV Last' = 
			CALCULATE (
			    AVERAGE ( 'Fund NAV'[nav] ),
			    LASTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Fund NAV' ) ) )
			)
		lineageTag: adf4e62d-6651-429e-8268-690ba43825b5
		formatString: #,0.00
		displayFolder: 5 Mutual Funds

	measure 'NAV First' = 
			CALCULATE (
			    AVERAGE ( 'Fund NAV'[nav] ),
			    FIRSTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Fund NAV' ) ) )
			)
		lineageTag: 54c63cd8-8945-4f27-97fa-2d8dfb2ca025
		formatString: #,0.00
		displayFolder: 5 Mutual Funds

	measure 'Fund Period Return %' = DIVIDE ( [NAV Last], [NAV First] ) - 1
		lineageTag: e08596db-1d87-4966-8710-d430f071d879
		formatString: 0.0%
		displayFolder: 5 Mutual Funds

	measure 'Fund Period CAGR %' = 
			VAR _days = DATEDIFF ( FIRSTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Fund NAV' ) ) ),
			                       LASTNONBLANK ( 'Date'[Date], CALCULATE ( COUNTROWS ( 'Fund NAV' ) ) ), DAY )
			RETURN IF ( _days >= 365, POWER ( DIVIDE ( [NAV Last], [NAV First] ), DIVIDE ( 365, _days ) ) - 1, [Fund Period Return %] )
		lineageTag: 94a1875d-2db6-4edb-82de-ffccf86c2ca2
		formatString: 0.0%
		displayFolder: 5 Mutual Funds

	measure 'Growth of 100' = 
			VAR _first = CALCULATE ( [NAV First], ALLSELECTED ( 'Date' ) )
			RETURN DIVIDE ( [NAV], _first ) * 100
		lineageTag: 09cb3942-43f5-4a85-bbc9-f87af668a617
		formatString: #,0.00
		displayFolder: 5 Mutual Funds

	measure 'Fund Count' = DISTINCTCOUNT ( Funds[scheme_code] )
		lineageTag: 587ef344-6f3f-420c-98b8-e4cc1bc044fc
		formatString: #,0
