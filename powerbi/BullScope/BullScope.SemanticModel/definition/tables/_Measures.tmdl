		displayFolder: 3 Indices

	measure 'NIFTY 50 Last' = CALCULATE ( [Index Last], 'Index Prices'[symbol] = "NIFTY 50" )
		lineageTag: bc2cbb0d-dd33-4cc7-ab7f-089acd5f4822
