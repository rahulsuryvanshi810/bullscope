	measure 'Cumulative FII Net (Cr)' = 
			CALCULATE (
			    [FII Net (Cr)],
			    FILTER ( ALLSELECTED ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) )
			)
		lineageTag: 6601ddd0-3170-4437-a8f7-ef5a060edf5b
		formatString: ₹#,0
		displayFolder: 4 FII DII (modelled)

	measure 'Cumulative DII Net (Cr)' = 
			CALCULATE (
			    [DII Net (Cr)],
			    FILTER ( ALLSELECTED ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) )
			)
		lineageTag: 11c58ef0-dd46-4c09-8752-87aa5408f9ac
		formatString: ₹#,0
