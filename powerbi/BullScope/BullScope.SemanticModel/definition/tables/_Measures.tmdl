	measure 'Call OI' = CALCULATE ( SUM ( 'Option Chain'[oi] ), 'Option Chain'[type] = "CE" )
		lineageTag: d56f0350-8c45-4ce2-a7f4-8ad54d0b0d1a
		formatString: #,0
		displayFolder: 7 Options (modelled OI)

	measure 'Put OI' = CALCULATE ( SUM ( 'Option Chain'[oi] ), 'Option Chain'[type] = "PE" )
		lineageTag: 35ce8841-4973-4d6c-8dca-bfb7001a9a8b
		formatString: #,0
		displayFolder: 7 Options (modelled OI)

	measure 'Call Change in OI' = CALCULATE ( SUM ( 'Option Chain'[chg_oi] ), 'Option Chain'[type] = "CE" )
		lineageTag: 9b4e2c24-9479-41e6-8927-7d9b6e0d2648
		formatString: #,0
		displayFolder: 7 Options (modelled OI)

	measure 'Put Change in OI' = CALCULATE ( SUM ( 'Option Chain'[chg_oi] ), 'Option Chain'[type] = "PE" )
		lineageTag: 7118e364-7709-4749-927e-ecfaa79ac9aa
		formatString: #,0
		displayFolder: 7 Options (modelled OI)

	measure 'PCR' = DIVIDE ( [Put OI], [Call OI] )
		lineageTag: 82dc4c8e-36b5-429a-acf5-e81e71316269
		formatString: 0.00
		displayFolder: 7 Options (modelled OI)

	measure 'PCR Mood' = SWITCH ( TRUE (), [PCR] > 1.2, "Bullish", [PCR] < 0.8, "Bearish", "Neutral" )
		lineageTag: f5b78cc7-e6b3-4944-8b32-3e357922bac2
		displayFolder: 7 Options (modelled OI)

	measure 'Spot' = MAX ( 'Option Chain'[spot] )
		lineageTag: a8aa7158-2b70-4525-bc67-f831cbc84759
		formatString: #,0.00
		displayFolder: 7 Options (modelled OI)

	measure 'Call Premium' = CALCULATE ( AVERAGE ( 'Option Chain'[ltp] ), 'Option Chain'[type] = "CE" )
		lineageTag: a9f25336-83f4-49a9-88a6-39d015b52908
		formatString: #,0.00
		displayFolder: 7 Options (modelled OI)

	measure 'Put Premium' = CALCULATE ( AVERAGE ( 'Option Chain'[ltp] ), 'Option Chain'[type] = "PE" )
		lineageTag: 17e8392a-55ce-45db-9e87-e04ca2086977
		formatString: #,0.00
		displayFolder: 7 Options (modelled OI)

	measure 'ATM IV %' = 
			VAR _s = [Spot]
			VAR _atm = MINX ( TOPN ( 1, VALUES ( 'Option Chain'[strike] ), ABS ( 'Option Chain'[strike] - _s ), ASC ), 'Option Chain'[strike] )
			RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Option Chain'[iv] ), 'Option Chain'[strike] = _atm ), 100 )
		lineageTag: 3c20592f-c04a-46c4-b3b6-3fe1d1843324
		formatString: 0.0%
		displayFolder: 7 Options (modelled OI)

	measure 'Max Pain' = 
			VAR _rows = 'Option Chain'
			VAR _pain =
			    ADDCOLUMNS (
			        VALUES ( 'Option Chain'[strike] ),
			        "@pain",
			            VAR k = 'Option Chain'[strike]
			            RETURN SUMX ( _rows, IF ( 'Option Chain'[type] = "CE", MAX ( 0, k - 'Option Chain'[strike] ), MAX ( 0, 'Option Chain'[strike] - k ) ) * 'Option Chain'[oi] )
			    )
			RETURN MINX ( TOPN ( 1, _pain, [@pain], ASC ), 'Option Chain'[strike] )
		lineageTag: ce7ae7f6-3982-4cff-8f77-a665ac3c5640
		formatString: #,0.00
		displayFolder: 7 Options (modelled OI)

	column 'Value'
